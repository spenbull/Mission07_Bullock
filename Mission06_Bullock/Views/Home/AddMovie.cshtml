@model Application

<div class="container mt-4">
    <!-- Page heading with Bootstrap styling -->
    <h1 class="text-primary">Add Movie</h1>

    <!-- Form with Bootstrap styling -->
    <form method="post" class="mt-3">
        <!-- Hidden input to store MovieId for editing existing records -->
        <input type="hidden" asp-for="MovieId">

        <!-- Movie Title -->
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Movie Title:</label>
            <input asp-for="Title" class="form-control" required maxlength="25">
        </div>

        <!-- Year Released -->
        <div class="mb-3">
            <label asp-for="Year" class="form-label">Year Released:</label>
            <input asp-for="Year" class="form-control" required maxlength="4">
        </div>

        <!-- Category Dropdown -->
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Category:</label>
            <select asp-for="CategoryId" class="form-select" required>
                <option value="">Select a Category</option>
                @foreach (Category m in ViewBag.Category)
                {
                    <option value="@m.CategoryId">@m.CategoryName</option>
                }
            </select>
        </div>

        <!-- Director -->
        <div class="mb-3">
            <label asp-for="Director" class="form-label">Director:</label>
            <input asp-for="Director" class="form-control" required maxlength="50">
        </div>

        <!-- Rating Dropdown -->
        <div class="mb-3">
            <label asp-for="Rating" class="form-label">Rating:</label>
            <select asp-for="Rating" class="form-select" required>
                <option value="">Select a Rating</option>
                <option>G</option>
                <option>PG</option>
                <option>PG-13</option>
                <option>R</option>
                <option>NR</option>
            </select>
        </div>

        <!-- Edited Dropdown -->
        <div class="mb-3">
            <label asp-for="Edited" class="form-label">Edited?</label>
            <select asp-for="Edited" class="form-select">
                <option value="">Select</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <!-- Lent To -->
        <div class="mb-3">
            <label asp-for="LentTo" class="form-label">Lent To:</label>
            <input asp-for="LentTo" class="form-control" maxlength="50">
        </div>

        <!-- Copied to Plex Dropdown -->
        <div class="mb-3">
            <label asp-for="CopiedToPlex" class="form-label">Copied to Plex?</label>
            <select asp-for="CopiedToPlex" class="form-select">
                <option value="">Select</option>
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <!-- Notes -->
        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Notes:</label>
            <textarea asp-for="Notes" class="form-control" maxlength="250"></textarea>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Submit Movie
        </button>
    </form>
</div>